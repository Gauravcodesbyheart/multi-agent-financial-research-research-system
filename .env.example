# ─── Complete list of variables this app reads ────────────────────────────────
# Anything not listed here is ignored. In particular these common guesses do NOT
# work and have no effect: AI_PROVIDER, EMBEDDING_PROVIDER, GROQ_EMBEDDING_MODEL,
# GROQ_MAX_COMPLETION_TOKENS, GOOGLE_API_KEY, GEMINI_API_KEY.
#
# Required : DATABASE_URL, NEXTAUTH_SECRET
# Needed for AI answers : GROQ_API_KEY
# Migrations : DIRECT_URL   Optional : CRON_SECRET, SEED_SECRET
# Optional embeddings : EMBEDDING_BASE_URL, EMBEDDING_API_KEY, EMBEDDING_MODEL
# Optional tuning : LLM_BASE_URL, GROQ_MODEL, GROQ_MODEL_PRO, LLM_MODEL,
#                   LLM_MODEL_PRO, LLM_TIMEOUT_MS, DATABASE_POOL_MAX,
#                   DATABASE_CONNECT_TIMEOUT_MS, DATABASE_URL_UNPOOLED
# NEXTAUTH_URL is read by NextAuth itself (set it to your deployed URL in production).

# ─── Database: Neon (required) ─────────────────────────────────────────────────
# Neon dashboard → Project → Connect → "Pooled connection".
# The pooled host contains `-pooler` and must include ?sslmode=require.
# PgBouncer multiplexes many client connections; keep DATABASE_POOL_MAX low on serverless.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon dashboard → "Direct connection" (no -pooler). Used ONLY by drizzle-kit for
# migrations: PgBouncer runs in transaction mode and drops the session state that
# DDL statements need. The app never uses this value.
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional connection tuning (defaults: 10 locally, 2 when a serverless runtime is detected).
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=10000

# ─── Authentication (required in production) ───────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# ─── AI: Groq (required for the agents to synthesize answers) ──────────────────
# Get a key at https://console.groq.com/keys
# Without a key the app still runs: documents are indexed and the Research Agent
# returns the retrieved source passages verbatim instead of an AI-written answer.
GROQ_API_KEY=

# Groq is OpenAI-compatible. LLM_BASE_URL lets you point the same code at any other
# compatible server (Together, OpenRouter, Ollama, vLLM, OpenAI). Default:
#   https://api.groq.com/openai/v1
# LLM_BASE_URL=

# Model IDs from https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# Larger model for narrative reports; falls back to GROQ_MODEL when unset.
# GROQ_MODEL_PRO=openai/gpt-oss-120b

# ─── Optional: separate embedding provider ─────────────────────────────────────
# Groq has NO embeddings API (verified against console.groq.com/docs/models — it lists
# no embedding models, and /openai/v1 has no /embeddings route). There is no Groq
# embeddings model to name here, so semantic search stays OFF unless you configure a
# different provider below. Keyword retrieval needs no provider and always works.
# Keyword retrieval always works and needs no external service. Any OpenAI-compatible
# /embeddings endpoint works: OpenAI, Voyage, Jina, Ollama, vLLM, ...
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# Running models locally with Ollama instead? Then:
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text          (note: dots, not underscores)

# ─── Optional ─────────────────────────────────────────────────────────────────
# Required by the scheduled durable document-job worker in production.
CRON_SECRET=
# Required only to invoke the demo seeder in production.
SEED_SECRET=
