DATABASE_URL=postgresql://username:password@host:5432/database
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Text generation: auto prefers Groq, then Gemini. Set to groq, gemini, or none to override.
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=4096

# Embeddings are separate from text generation; auto prefers Groq, then Gemini.
# Set EMBEDDING_PROVIDER=groq to force Groq's Nomic embedding model.
EMBEDDING_PROVIDER=auto
GROQ_EMBEDDING_MODEL=nomic-embed-text-v1_5

# Optional Gemini text provider and/or embedding fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional. Required by the scheduled durable document-job worker in production.
CRON_SECRET=

# Optional. Required only to invoke the demo seeder in production.
SEED_SECRET=
