DATABASE_URL=postgresql://username:password@host:5432/database
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Text generation: auto prefers Groq, then Gemini. Set to groq, gemini, or none to override.
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=4096

# Optional Gemini fallback for text generation and optional semantic embeddings.
# Groq-only setups use keyword retrieval unless a Gemini embedding key is also configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional. Required by the scheduled durable document-job worker in production.
CRON_SECRET=

# Optional. Required only to invoke the demo seeder in production.
SEED_SECRET=
