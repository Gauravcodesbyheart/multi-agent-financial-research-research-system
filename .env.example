# --- Database (required) -------------------------------------------------------
# Local Postgres, Docker, Neon, Supabase, or any PostgreSQL 14+ instance.
# Hosted providers (Neon/Supabase/Render) are auto-detected and use TLS.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL=postgresql://username:password@host:5432/database

# Optional connection tuning.
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=10000

# --- Authentication (required in production) -----------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# --- AI (required for the agents to synthesize answers) ------------------------
# Without a key the app still runs: documents are indexed and the Research Agent
# returns the retrieved source passages verbatim instead of an AI-written answer.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides. Defaults track the current stable Gemini Flash release.
# If a configured model is retired or unavailable, the client automatically retries
# with a known-good model and reports the substitution on /api/health.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.8-flash
# gemini-embedding-001 is stable until 2028; switching models requires re-embedding
# every chunk because the vector spaces are incompatible.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Optional ----------------------------------------------------------------
# Required by the scheduled durable document-job worker in production.
CRON_SECRET=
# Required only to invoke the demo seeder in production.
SEED_SECRET=
